[node name="Window" type="Area3D" parent="Things"]
position = Vector3(1, 1, -8)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("The gas giant fills the window, pink and violet and swirling. The little gold specks are more casinos.", "...It's kind of beautiful. Don't tell Sal.")

[node name="Shape" type="CollisionShape3D" parent="Things/Window"]
shape = SubResource("Sphere_use")

[node name="Roulette" type="Area3D" parent="Things"]
position = Vector3(-1, 1, -0.2)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("A roulette table. The croupier's on break. The croupier has been on break since she got here.", "She puts a mental chip on 17. It comes up 4. Figures.")

[node name="Shape" type="CollisionShape3D" parent="Things/Roulette"]
shape = SubResource("Sphere_use")

[node name="Stage" type="Area3D" parent="Things"]
position = Vector3(-7.5, 1, 4.4)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("A tiny stage, a red curtain, one microphone. TONIGHT: THE CROONING CRAB.", "The crab is not here. The crab is never here. The sign has said tonight for nine years.")

[node name="Shape" type="CollisionShape3D" parent="Things/Stage"]
shape = SubResource("Sphere_use")

[node name="ClockGhost" type="Area3D" parent="Things"]
position = Vector3(0, 1, 8)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("A pale square on the wall where a clock used to be.", "Sal had it taken down. Sal had all of them taken down.")

[node name="Shape" type="CollisionShape3D" parent="Things/ClockGhost"]
