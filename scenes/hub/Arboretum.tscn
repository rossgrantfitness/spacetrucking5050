[node name="Window" type="Area3D" parent="Things"]
position = Vector3(1, 1, -8)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("Greenhouse Reach's planet fills the window: deep greens, blue lakes, pink meadows you can see from orbit.", "Little lights drift past outside. Jellyfish, coming to look at the dome.")

[node name="Shape" type="CollisionShape3D" parent="Things/Window"]
shape = SubResource("Sphere_use")

[node name="Trunk" type="Area3D" parent="Things"]
position = Vector3(3, 1, -2)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("The great tree's trunk comes up through the floor and out through the ceiling. It's warm to the touch.", "Ninety-one years. She puts her ear to it. It hums. Probably the pipes. Probably.")

[node name="Shape" type="CollisionShape3D" parent="Things/Trunk"]
shape = SubResource("Sphere_use")

[node name="Pond" type="Area3D" parent="Things"]
position = Vector3(3, 1, 0.9)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("A little pond with lily pads. A fish looks up at her, decides she isn't food, and goes back to thinking.")

[node name="Shape" type="CollisionShape3D" parent="Things/Pond"]
shape = SubResource("Sphere_use")

[node name="Planter" type="Area3D" parent="Things"]
position = Vector3(-2, 1, -0.4)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("Ferns, in a planter, very sincerely growing.", "A tag in the soil says PLEASE DO NOT TALK TO THE FERNS. THEY ARE SHY.")

[node name="Shape" type="CollisionShape3D" parent="Things/Planter"]
