[node name="Window" type="Area3D" parent="Things"]
position = Vector3(1, 1, -8)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("The Frostline's planet fills the window: lavender ice, blue cracks, snow swirling over the poles.", "It's the top of the map. It's very quiet up here. Nice quiet.")

[node name="Shape" type="CollisionShape3D" parent="Things/Window"]
shape = SubResource("Sphere_use")

[node name="GiantCone" type="Area3D" parent="Things"]
position = Vector3(6, 1, 5.3)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("A giant cone, three scoops and a cherry, made of something that is definitely not ice cream.", "She licks it anyway. Fiberglass. Penny saw. Penny's not mad.")

[node name="Shape" type="CollisionShape3D" parent="Things/GiantCone"]
shape = SubResource("Sphere_use")

[node name="Freezers" type="Area3D" parent="Things"]
position = Vector3(9.5, 1, -4.6)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("Freezers full of comet ice cream, humming. The new coils hum in harmony.", "Eighty flavors. One plain. The plain is the most popular.")

[node name="Shape" type="CollisionShape3D" parent="Things/Freezers"]
shape = SubResource("Sphere_use")

[node name="Booth" type="Area3D" parent="Things"]
position = Vector3(2.2, 1, 0.5)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("A pink booth. Somebody carved initials in the table, years ago, very small: just a W.", "...Probably nobody.")

