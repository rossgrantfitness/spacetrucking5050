[node name="Window" type="Area3D" parent="Things"]
position = Vector3(1, 1, -8)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("The Dustbowl's planet fills the window: amber dunes, dry canyons, a storm crawling across the middle.", "Somewhere down there is a fridge. In a canyon. Holding nothing.")

[node name="Shape" type="CollisionShape3D" parent="Things/Window"]
shape = SubResource("Sphere_use")

[node name="Fridge" type="Area3D" parent="Things"]
position = Vector3(-2.5, 1, -6.9)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("An old fridge. A note on it says NOT FOR SALE.", "She opens it. Inside: one sandwich, labeled MAGS. A bite's been taken out of the label.")

[node name="Shape" type="CollisionShape3D" parent="Things/Fridge"]
shape = SubResource("Sphere_use")

[node name="ScrapPile" type="Area3D" parent="Things"]
position = Vector3(4.5, 1, -3.8)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("A pile of scrap: a rig door, a toaster, half a satellite, a sign that says WELCOME TO.", "Welcome to what? The rest is somewhere else in the pile. Probably.")

[node name="Shape" type="CollisionShape3D" parent="Things/ScrapPile"]
shape = SubResource("Sphere_use")

[node name="Hook" type="Area3D" parent="Things"]
position = Vector3(3.5, 1, -1)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("The crane hook, hanging from the ceiling rail. It sways a little when nobody's touching it.", "Mags says it's the air vents. Mags says that about a lot of things.")

[node name="Shape" type="CollisionShape3D" parent="Things/Hook"]
shape = SubResource("Sphere_use")

[node name="Workbench" type="Area3D" parent="Things"]
position = Vector3(-3, 1, 5.6)
script = ExtResource("9_examine")
prompt = "LOOK"
lines = PackedStringArray("A workbench covered in half-fixed radios. One plays a song backwards.", "She listens for a while. It's kind of nice backwards.")

[node name="Shape" type="CollisionShape3D" parent="Things/Workbench"]
shape = SubResource("Sphere_use")

