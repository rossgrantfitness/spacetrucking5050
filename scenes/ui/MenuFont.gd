	"o": [".....", ".....", ".###.", "#...#", "#...#", "#...#", ".###."],
	"p": [".....", ".....", "####.", "#...#", "#...#", "#...#", "####.", "#....", "#...."],
	"q": [".....", ".....", ".####", "#...#", "#...#", "#...#", ".####", "....#", "....#"],
	"r": ["....", "....", "#.##", "##..", "#...", "#...", "#..."],
	"s": [".....", ".....", ".####", "#....", ".###.", "....#", "####."],
