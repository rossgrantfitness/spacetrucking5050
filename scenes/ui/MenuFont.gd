	"8": [".###.", "#...#", "#...#", ".###.", "#...#", "#...#", ".###."],
	"9": [".###.", "#...#", "#...#", ".####", "....#", "....#", ".###."],
	",": [".", ".", ".", ".", ".", ".", "#", "#"],
	";": [".", ".", "#", ".", ".", ".", "#", "#"],
	"?": [".###.", "#...#", "....#", "...#.", "..#..", ".....", "..#.."],
	"'": ["#", "#", ".", ".", ".", ".", "."],
	"’": ["#", "#", ".", ".", ".", ".", "."],
	"“": ["#.#", "#.#", "...", "...", "...", "...", "..."],
	"”": ["#.#", "#.#", "...", "...", "...", "...", "..."],
