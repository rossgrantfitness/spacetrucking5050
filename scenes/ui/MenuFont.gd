## Every letter the font has: the ones above, plus any other punctuation
## borrowed from the HUD font (PixelFont.gd).
static func all_glyphs() -> Dictionary:
	var glyphs := {}
	for character: String in PixelFont.GLYPHS:
		if not (character.to_upper() != character.to_lower() or character in "0123456789"):
			glyphs[character] = PixelFont.GLYPHS[character]
	for character: String in GLYPHS:
		glyphs[character] = GLYPHS[character]
	return glyphs
