# Godot 4 keeps its import cache and editor state here. It's rebuilt
# automatically when you open the project, so it never goes in git.
.godot/
/android/

# Exported game builds (made later via Project > Export).
/build/
/exports/

# Temporary file created (and removed) by tools/validate.sh.
/override.cfg

# OS clutter.
.DS_Store
Thumbs.db
