; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Space Truckin' 5050"
config/description="A cozy PSX-style space trucking sim. No combat, just the drive."
run/main_scene="res://scenes/boot/PowerOn.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Events="*res://autoload/Events.gd"
SaveSystem="*res://autoload/SaveSystem.gd"
Settings="*res://autoload/Settings.gd"
GameState="*res://autoload/GameState.gd"
Economy="*res://autoload/Economy.gd"
TimeOfDay="*res://autoload/TimeOfDay.gd"
Radio="*res://autoload/Radio.gd"
Dialogue="*res://autoload/Dialogue.gd"
Sfx="*res://autoload/Sfx.gd"
DebugMenu="*res://autoload/DebugMenu.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_antialiasing=0
theme/custom_font="res://fonts/pixel_font.tres"

