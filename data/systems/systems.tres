[ext_resource type="Resource" path="res://data/systems/frostline.tres" id="b4_frostline"]

[resource]
script = ExtResource("1_list")
systems = Array[ExtResource("2_system")]([ExtResource("3_home"), ExtResource("4_tidewater"), ExtResource("5_glimmer"), ExtResource("b4_dustbowl"), ExtResource("b4_greenhouse"), ExtResource("b4_frostline")])
