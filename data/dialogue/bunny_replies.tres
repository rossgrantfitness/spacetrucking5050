[gd_resource type="Resource" script_class="BunnyReplies" format=3]

[ext_resource type="Script" path="res://data/dialogue/BunnyReplies.gd" id="1_replies"]
[ext_resource type="Resource" path="res://data/npcs/bunny_jack.tres" id="2_jack"]

[resource]
script = ExtResource("1_replies")
voice = ExtResource("2_jack")
takeoff = PackedStringArray("Copy.", "Yeah, yeah.", "...is it Tuesday?", "Roger. Or whatever.", "On it. Slowly.", "Rig's warm. I'm not.")
idle = PackedStringArray("Mm.", "Tell me about it.", "*sips coffee*", "Cool story.", "Uh huh.", "Wild.", "Same, honestly.", "I'm just here for the radio.", "Can't talk. Vibing.")
approach = PackedStringArray("Coming in.", "Don't rush me.", "Save me a coffee.", "Yeah, I see you. Big ring. Very nice.", "Leave the light on.")
bonk = PackedStringArray("It was like that when I got here.", "Rock started it.", "...ow.", "Space is crowded today.", "That rock had it coming.")
boost = PackedStringArray("Wheee. I guess.", "Gotta go fast. Apparently.", "Don't tell my mechanic.", "Somebody's gotta.")
low_fuel = PackedStringArray("I know.", "Running on fumes and vibes.", "The light's just a suggestion.", "Yep. Saw it.")
docking = PackedStringArray("Thanks.", "Park it nice, robot.", "Wake me when we're in.", "Smooth. Like butter. Space butter.")
rough = PackedStringArray("Pies are tough. They'll live.", "My bad.", "Sorry, sorry.", "That was the road. Not me.", "Character-building cargo.")
speeding = PackedStringArray("Was I speeding? Huh.", "Put it on my tab.", "Worth it.", "Officer, I was vibing.", "...Fair.")
