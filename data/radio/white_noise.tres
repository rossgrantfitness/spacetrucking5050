tracks = PackedStringArray("THE HOLLOW MOONS - SLOW LANE", "MARGARET AND THE PIES - CHERRY, LATTICE TOP", "DEEP SPACE LOUNGE BAND - BUOY", "STATIC SAINTS - TWO HEARTS, ONE RIG", "THE LONG HAULERS - PINE", "KITCHEN RADIO - THE HALLWAY SMELLS LIKE HOME", "SIDE B - THE ONE SHE PRETENDS NOT TO LIKE")
dj_lines = PackedStringArray("This one's for the Tidewater lane. Long and boring. Like me.", "J, if you're listening: water the plant.", "(tape hiss)", "That was a good one. This next one's better. Trust me.", "Side B coming up. You're welcome.", "Raccoony, if you're listening, the donuts are in the glovebox.", "...okay, I'll stop talking. Here's a song.")
dj_on_storm = PackedStringArray("(the tape wobbles. it always did in storms.)")
dj_on_delivery = PackedStringArray("(tape hiss)")
dj_on_ticket = PackedStringArray("(tape hiss)")
dj_on_new_system = PackedStringArray("(tape hiss)")
