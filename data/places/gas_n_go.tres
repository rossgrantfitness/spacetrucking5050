[resource]
script = ExtResource("1_place")
id = "gas_n_go"
display_name = "GAS-N-GO 47"
kind = 2
services = PackedStringArray("fuel", "snacks", "souvenir")
host = ExtResource("2_moe")
host_lines = PackedStringArray("Welcome... to... Gas-N-Go. You... ever... wonder... why they call it... a gas... station...", "...when it's... in space... and the gas... is... rocket fuel... and it doesn't... station... anywhere...", "...anyway. That's... what I... was saying. Last time. Pumps... are on.", "Welcome... back. Jerky... is... warm. Ish. Fuel's... cheap. Cheaper... than Lily's. Don't... tell her.", "Long... haul? ...Same.")
host_lines_in_order = true
fuel_price_factor = 0.7
