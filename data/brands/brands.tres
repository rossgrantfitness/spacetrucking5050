[resource]
script = ExtResource("1_catalog")
brands = Array[ExtResource("2_brand")]([SubResource("brand_moon_milk"), SubResource("brand_neon"), SubResource("brand_zoom"), SubResource("brand_old_orbit"), SubResource("brand_galaxy_gumballs"), SubResource("brand_mochi_moons"), SubResource("brand_star_stop"), SubResource("brand_cozy_coil"), SubResource("brand_dr_sprinkle"), SubResource("brand_tidewater_cannery"), SubResource("brand_marges"), SubResource("brand_high_roller")])
products = Array[ExtResource("3_product")]([SubResource("product_moon_milk"), SubResource("product_moon_milk_strawberry"), SubResource("product_moon_milk_capsules"), SubResource("product_neon_soda"), SubResource("product_neon_lime_zero"), SubResource("product_neon_after_dark"), SubResource("product_zoom_juice"), SubResource("product_zoom_turbo"), SubResource("product_space_jerky"), SubResource("product_space_jerky_teriyaki"), SubResource("product_galaxy_gumballs"), SubResource("product_mochi_matcha"), SubResource("product_mochi_sakura"), SubResource("product_star_stop_ramen"), SubResource("product_star_stop_comet"), SubResource("product_cozy_cocoa"), SubResource("product_sprinkle_putty"), SubResource("product_canned_starfish"), SubResource("product_kelp_crisps"), SubResource("product_nebula_pie"), SubResource("product_marges_coffee"), SubResource("product_chip_chips")])
