[gd_resource type="Resource" script_class="BrandCatalog" format=3]

[ext_resource type="Script" path="res://data/brands/BrandCatalog.gd" id="1_catalog"]
[ext_resource type="Script" path="res://data/brands/BrandData.gd" id="2_brand"]
[ext_resource type="Script" path="res://data/brands/ProductData.gd" id="3_product"]

[sub_resource type="Resource" id="brand_moon_milk"]
script = ExtResource("2_brand")
id = "moon_milk"
display_name = "MOON MILK"
slogan = "Now with 30% less gravity."
story = "Bottled on the dairy moons of Home Space, where the cows graze in low gravity and the milk floats up out of the pail if you're not quick. Every trucker's had a Moon Milk at three in the morning. Most of them have had it on the ceiling."
color = Color(0.92, 0.94, 1, 1)

[sub_resource type="Resource" id="brand_neon"]
script = ExtResource("2_brand")
id = "neon"
display_name = "NEON SODA WORKS"
slogan = "Tastes like a sunset. Glows a bit."
story = "Started in a casino basement in the Glimmer System by a bartender who spilled something into the jukebox. The glow is natural. Mostly. The cans are collectible, if you're the kind of person who keeps cans."
color = Color(1, 0.35, 0.75, 1)

[sub_resource type="Resource" id="brand_zoom"]
script = ExtResource("2_brand")
id = "zoom"
display_name = "ZOOM JUICE"
slogan = "Now with 40% more zoom."
story = "An energy drink first brewed on a racing asteroid by a pit crew who never slept. Haulers swear by it. Dentists swear at it. Nobody knows what the first 100% of zoom was."
color = Color(1, 0.85, 0.1, 1)

[sub_resource type="Resource" id="brand_old_orbit"]
script = ExtResource("2_brand")
id = "old_orbit"
display_name = "OLD ORBIT SPACE JERKY"
slogan = "Mysteriously chewy since forever."
story = "Nobody knows what animal it's from. The packet just says 'space'. The founder took the recipe to his grave and then, they say, came back for a bag."
color = Color(0.7, 0.35, 0.2, 1)

[sub_resource type="Resource" id="brand_galaxy_gumballs"]
script = ExtResource("2_brand")
id = "galaxy_gumballs"
display_name = "GALAXY GUMBALLS"
slogan = "Collect all 9000."
story = "Every gumball has a tiny planet printed on it, and there are 9,000 planets. Nobody has ever collected them all. Somebody in the Glimmer System has 8,999 and won't talk about it."
color = Color(0.4, 0.6, 1, 1)

[sub_resource type="Resource" id="brand_mochi_moons"]
script = ExtResource("2_brand")
id = "mochi_moons"
display_name = "MOCHI MOONS"
slogan = "The snack that orbits your mouth."
story = "Soft rice-cake moons from a little family bakery that came loose from its station in a solar storm and just kept baking. Matcha is the classic. Sakura is for special occasions, like Tuesday."
color = Color(0.6, 0.85, 0.5, 1)

[sub_resource type="Resource" id="brand_star_stop"]
script = ExtResource("2_brand")
id = "star_stop"
display_name = "STAR-STOP RAMEN"
slogan = "Hot noodles at every ring on the road."
story = "The cup noodles of the spaceways: add hot water, wait three minutes, burn your tongue anyway. Every cab in the galaxy smells a little of it. There's a Star-Stop in every machine, and nobody remembers putting them there."
color = Color(0.95, 0.3, 0.2, 1)

[sub_resource type="Resource" id="brand_cozy_coil"]
script = ExtResource("2_brand")
id = "cozy_coil"
display_name = "COZY COIL COCOA"
slogan = "Drop one in space. It just floats there. Cozy."
story = "Hot cocoa cubes from the people who sponsor the late-night lo-fi on Cozy Coil radio. Drop one in hot water, or just let it float around the cab and smell it."
color = Color(0.55, 0.35, 0.25, 1)

[sub_resource type="Resource" id="brand_dr_sprinkle"]
script = ExtResource("2_brand")
id = "dr_sprinkle"
display_name = "DR. SPRINKLE'S"
slogan = "Hull putty. It's also a snack."
story = "Dr. Sprinkle invented a hull putty so good it patched a moon. Then he noticed it tasted like birthday cake. The company sells both, out of the same tub. Please read the label."
color = Color(1, 0.75, 0.9, 1)

[sub_resource type="Resource" id="brand_tidewater_cannery"]
script = ExtResource("2_brand")
id = "tidewater_cannery"
display_name = "TIDEWATER CANNERY"
slogan = "We can, therefore we are."
story = "The cannery in the teal Tidewater system. Gill's family has canned whatever the tide brings in for nine generations. Some of it is fish."
color = Color(0.2, 0.8, 0.8, 1)

[sub_resource type="Resource" id="brand_marges"]
script = ExtResource("2_brand")
id = "marges"
display_name = "MARGE'S"
slogan = "Pie's on. Coffee's on. She's on."
story = "Marge's diner at the truck stop, home of the Nebula Pie. Marge puts slices in the vending machine at night so nobody goes hungry while she sleeps. She knows if you take two."
color = Color(1, 0.75, 0.3, 1)

[sub_resource type="Resource" id="brand_high_roller"]
script = ExtResource("2_brand")
id = "high_roller"
display_name = "THE HIGH ROLLER"
slogan = "The house always wins. The snacks always lose."
story = "Sal Grinwell's casino in the Glimmer System sells its own snacks, shaped like the things you're losing. Sal says that's called branding."
color = Color(0.8, 0.3, 1, 1)

[sub_resource type="Resource" id="product_moon_milk"]
script = ExtResource("3_product")
id = "moon_milk"
display_name = "Moon Milk"
brand_id = "moon_milk"
kind = "drink"
price = 4
blurb = "The original. Shake it before it floats off."
taste_lines = PackedStringArray("Cold. Floaty. Tastes like being a kid on a slow ship.", "*glug* ...I have a milk mustache, don't I.")
effect = "steady"
package = "bottle"
sold_at = PackedStringArray()

[sub_resource type="Resource" id="product_moon_milk_strawberry"]
script = ExtResource("3_product")
id = "moon_milk_strawberry"
display_name = "Moon Milk: Strawberry Phase"
brand_id = "moon_milk"
kind = "drink"
price = 5
blurb = "Pink. For the inner child. And the outer one."
taste_lines = PackedStringArray("Pink milk. I'm thirty-five. Don't look at me.", "Strawberry Phase. I've been in one since forever.")
effect = "none"
package = "bottle"
sold_at = PackedStringArray()

