[gd_resource type="Resource" script_class="NPCData" format=3]

[ext_resource type="Script" path="res://data/npcs/NPCData.gd" id="1_npc"]
[ext_resource type="Script" path="res://data/npcs/Conversation.gd" id="2_conv"]
[ext_resource type="Resource" path="res://data/jobs/first_long_haul.tres" id="job_first_long_haul"]
[ext_resource type="Resource" path="res://data/jobs/white_pie.tres" id="job_white_pie"]

[sub_resource type="Resource" id="Conversation_boss_first"]
script = ExtResource("2_conv")
blocked_by_flags = PackedStringArray("met_boss", "met_marge")
lines = PackedStringArray("Hey, sugar. {boss}'s been pacing that office since breakfast. Your check's in there.", "Go get it over with. Then come see me: I might have some pie work for you.")

[sub_resource type="Resource" id="Conversation_0"]
script = ExtResource("2_conv")
blocked_by_flags = PackedStringArray("met_marge")
lines = PackedStringArray("Well, look at you. {boss} sent you over? My condolences. I'm Marge. I run this place: the diner, the tower, the whole shebang.", "My cousin Gill runs the canteen at Tidewater Cannery. Way out in the teal, past the border gate. Sixty clicks, give or take.", "Poor things haven't had a decent pie in a year. Thirty crates of nebula pie and a sack of real coffee. It's a long haul, sugar.", "About eighteen minutes at your rig's top speed. Four and a half if you burn a whole tank of boost, but boosting rattles the pies, and they bruise.", "Thirteen hundred {currency}, plus up to five hundred more if they get there pretty. Gas-N-Go's about halfway if you need fuel. What do you say?")
sets_flags = PackedStringArray("met_marge")
offers_job = ExtResource("job_first_long_haul")

[sub_resource type="Resource" id="Conversation_1"]
script = ExtResource("2_conv")
needs_flags = PackedStringArray("met_marge")
blocked_by_flags = PackedStringArray("first_mission_done")
needs_no_job = true
lines = PackedStringArray("Change your mind about the Tidewater run, sugar? Those pies won't haul themselves.")
offers_job = ExtResource("job_first_long_haul")

[sub_resource type="Resource" id="Conversation_2"]
script = ExtResource("2_conv")
needs_active_job = "first_long_haul"
lines = PackedStringArray("Pies are loaded, hon. Airlock's on the right, back the way you came.", "Press M in the cockpit to chart a course: the autopilot can drive while you listen to the radio. Gentle with my babies.")

[sub_resource type="Resource" id="Conversation_3a"]
script = ExtResource("2_conv")
needs_flags = PackedStringArray("first_mission_done", "first_long_haul_arrived_perfect")
blocked_by_flags = PackedStringArray("marge_heard_about_pies")
lines = PackedStringArray("Gill called! Not one bruised pie. Not ONE. Sugar, you drive like a cloud.", "Said the pies made a grown otter cry. You're hired, if you want it. Job board's by the big window.")
sets_flags = PackedStringArray("marge_heard_about_pies")

[sub_resource type="Resource" id="Conversation_3b"]
script = ExtResource("2_conv")
needs_flags = PackedStringArray("first_mission_done", "first_long_haul_arrived_bumpy")
blocked_by_flags = PackedStringArray("marge_heard_about_pies")
lines = PackedStringArray("Gill says the pies got there a little... rearranged. Tasted fine, he says.", "Gentle on the corners next time, hon. Anyway: you're hired, if you want it. Job board's by the big window.")
sets_flags = PackedStringArray("marge_heard_about_pies")

[sub_resource type="Resource" id="Conversation_3c"]
script = ExtResource("2_conv")
needs_flags = PackedStringArray("first_mission_done", "first_long_haul_arrived_rough")
blocked_by_flags = PackedStringArray("marge_heard_about_pies")
lines = PackedStringArray("Gill says it was more pie FILLING than pie. ...He ate it with a spoon. Bless him.", "We'll call it a learning experience. Job board's by the big window, sugar. Maybe something unbreakable.")
sets_flags = PackedStringArray("marge_heard_about_pies")

[sub_resource type="Resource" id="Conversation_3"]
script = ExtResource("2_conv")
needs_flags = PackedStringArray("first_mission_done")
needs_no_job = true
lines = PackedStringArray("Job board's by the big window. Lily's got fuel, Dusty can make that old rig sing. Make yourself at home.", "Gill's still talking about those pies, by the way.")

[sub_resource type="Resource" id="Conversation_4"]
script = ExtResource("2_conv")
lines = PackedStringArray("Coffee's on. Pie's on. I'm on.", "Don't let Wendell tell you about his cat. Too late? Too late.")

[sub_resource type="Resource" id="Conversation_sequins"]
script = ExtResource("2_conv")
needs_flags = PackedStringArray("sal_jumpsuits_done")
blocked_by_flags = PackedStringArray("marge_sequins")
lines = PackedStringArray("Three nights at that crocodile's casino, hon. Three! They threw SEQUINS at me.", "Karaoke night here is never going to be the same.", "Tell Sal thanks. Then tell him he still owes me for the pie he 'borrowed' in '43.")
sets_flags = PackedStringArray("marge_sequins")

[sub_resource type="Resource" id="Conversation_white_pie_haul"]
script = ExtResource("2_conv")
needs_active_job = "white_pie"
lines = PackedStringArray("Cherry, lattice top. Still warm.", "Don't you dare peek, sugar.")

[sub_resource type="Resource" id="Conversation_white_pie_after"]
script = ExtResource("2_conv")
marked = true
needs_flags = PackedStringArray("white_pie_done")
blocked_by_flags = PackedStringArray("marge_heard_white_pie")
lines = PackedStringArray("Gill called. Gill doesn't call. He called.", "Said \"still warm.\" Then he hung up. That's a speech, for Gill.", "Thank you, hon.")
sets_flags = PackedStringArray("marge_heard_white_pie")

[sub_resource type="Resource" id="Conversation_white_tapes"]
script = ExtResource("2_conv")
marked = true
needs_flags = PackedStringArray("white_story_done")
blocked_by_flags = PackedStringArray("marge_heard_tapes")
lines = PackedStringArray("Gill told me. About the crate. And the tapes.", "You bring one in sometime. We'll put it on the jukebox.", "> Side B.", "Side B, sugar. Obviously.")
sets_flags = PackedStringArray("marge_heard_tapes")

[sub_resource type="Resource" id="Conversation_white_offer"]
script = ExtResource("2_conv")
needs_flags = PackedStringArray("marge_mentioned_white")
blocked_by_flags = PackedStringArray("white_pie_done")
needs_no_job = true
min_deliveries = 4
lines = PackedStringArray("He left a standing order, you know. A cherry pie a month, for Gill. Paid a year ahead.", "There's months left on it. I kept baking them. Habit.", "Would you take this one out? It's paid for. He'd want it to get there warm.")
offers_job = ExtResource("job_white_pie")

[sub_resource type="Resource" id="Conversation_white_mention"]
script = ExtResource("2_conv")
marked = true
needs_flags = PackedStringArray("first_mission_done")
blocked_by_flags = PackedStringArray("marge_mentioned_white")
needs_no_job = true
min_deliveries = 2
lines = PackedStringArray("Sugar, can I tell you something? That rig of yours. I'd know that cough anywhere.", "{husband} drove her. Brought my pies out to Gill every week for nine years. Never once late.", "...Well. Once.", "> Yeah.", "Coffee's on me today. Don't argue. I'm older than you.")
sets_flags = PackedStringArray("marge_mentioned_white")

[resource]
script = ExtResource("1_npc")
display_name = "Marge (truck stop)"
species = "owl"
voice_pitch = 0.8
voice_type = "chirp"
voice_key = 4
voice_scale = "minor"
lines = PackedStringArray("Coffee's on. Pie's on. I'm on.")
comm_name = "MARGE · TRUCK STOP"
fur_color = Color(0.72, 0.55, 0.38, 1)
accent_color = Color(0.35, 0.95, 1, 1)
conversations = Array[ExtResource("2_conv")]([SubResource("Conversation_boss_first"), SubResource("Conversation_0"), SubResource("Conversation_1"), SubResource("Conversation_2"), SubResource("Conversation_sequins"), SubResource("Conversation_3a"), SubResource("Conversation_3b"), SubResource("Conversation_3c"), SubResource("Conversation_white_pie_haul"), SubResource("Conversation_white_pie_after"), SubResource("Conversation_white_tapes"), SubResource("Conversation_white_offer"), SubResource("Conversation_white_mention"), SubResource("Conversation_3"), SubResource("Conversation_4")])
