[gd_resource type="Resource" script_class="NPCData" format=3]

[ext_resource type="Script" path="res://data/npcs/NPCData.gd" id="1_npc"]
[ext_resource type="Script" path="res://data/npcs/Conversation.gd" id="2_conv"]
[ext_resource type="Resource" path="res://data/jobs/glimmer_cards.tres" id="job_glimmer_cards"]

[sub_resource type="Resource" id="Conversation_0"]
script = ExtResource("2_conv")
blocked_by_flags = PackedStringArray("met_marge")
needs_no_job = true
lines = PackedStringArray("Morning, {bunny}. You look like you slept in your jacket again.", "Got something for you, finally. Marge called. Runs the truck stop we're parked at.", "Her pie hauler retired to a moon. She needs a new one, and she pays in real {currency}.", "She's right outside, hon: down the hall, through the airlock. When you fly, follow the yellow diamond and fly through the ring.")
sets_flags = PackedStringArray("heard_about_marge")

[sub_resource type="Resource" id="Conversation_1"]
script = ExtResource("2_conv")
needs_active_job = "first_long_haul"
lines = PackedStringArray("Tidewater? That's a real haul, hon. Chart a course in the cockpit with M and let the autopilot drive if you get tired.")

[sub_resource type="Resource" id="Conversation_2"]
script = ExtResource("2_conv")
needs_flags = PackedStringArray("first_mission_done")
needs_no_job = true
lines = PackedStringArray("Look at you, an employed trucker. The job board's working again. Mostly.", "Pick something off the board, or go spend your money at the truck stop. I won't tell.")
opens_menu = "job_board"

[sub_resource type="Resource" id="Conversation_3"]
script = ExtResource("2_conv")
needs_flags = PackedStringArray("met_marge")
blocked_by_flags = PackedStringArray("first_mission_done")
needs_no_job = true
lines = PackedStringArray("Marge says you two met. Did you take her pie job? She's right outside the airlock, hon.")

[sub_resource type="Resource" id="Conversation_4"]
script = ExtResource("2_conv")
lines = PackedStringArray("You've got a load in the back, {bunny}. Cockpit's up the stairs. Go get paid.")

[sub_resource type="Resource" id="Conversation_glimmer"]
script = ExtResource("2_conv")
needs_flags = PackedStringArray("first_mission_done")
blocked_by_flags = PackedStringArray("glimmer_heard")
needs_no_job = true
lines = PackedStringArray("Hon. Got a call from out in the Glimmer System. The pink one, past the rocks the other way.", "Casino guy. Sal something. Wants forty thousand decks of cards, and he asked for 'the hauler with the old rig.' That's you.", "He smiles a lot. Like, a LOT. But his money's real. I checked. Twice.")
sets_flags = PackedStringArray("glimmer_heard")
offers_job = ExtResource("job_glimmer_cards")

[resource]
script = ExtResource("1_npc")
display_name = "Dottie (Dispatch, mornings)"
species = "raccoon"
voice_pitch = 1.35
voice_type = "soft"
voice_key = 5
voice_scale = "major"
lines = PackedStringArray("Morning, {bunny}. You look like you slept in your jacket again.", "Coffee's burnt, the job board's broken, and somebody fed the vending machine a sock.", "Cockpit's up the stairs, same as always. Fly safe, hon. Or at least fly.")
comm_name = "DOTTIE · DISPATCH"
fur_color = Color(0.62, 0.6, 0.66, 1)
accent_color = Color(1, 0.42, 0.75, 1)
conversations = Array[ExtResource("2_conv")]([SubResource("Conversation_0"), SubResource("Conversation_1"), SubResource("Conversation_glimmer"), SubResource("Conversation_2"), SubResource("Conversation_3"), SubResource("Conversation_4")])
