[gd_resource type="Resource" script_class="NPCData" format=3]

[ext_resource type="Script" path="res://data/npcs/NPCData.gd" id="1_npc"]
[ext_resource type="Script" path="res://data/npcs/Conversation.gd" id="2_conv"]
[ext_resource type="Resource" path="res://data/jobs/white_last_load.tres" id="job_white_last_load"]

[sub_resource type="Resource" id="Conversation_first"]
script = ExtResource("2_conv")
blocked_by_flags = PackedStringArray("met_boss", "met_marge")
lines = PackedStringArray("Rabbit. You're late.", "Fizzwick Pet Supply signed for the kitty litter. Congratulations. Here's your check.", "Don't spend it all in one place. You can't, anyway.")
sets_flags = PackedStringArray("met_boss")
opens_menu = "check_in"

[sub_resource type="Resource" id="Conversation_owner"]
script = ExtResource("2_conv")
needs_flags = PackedStringArray("owns_company")
lines = PackedStringArray("Boss! I mean... boss. Coffee? I made coffee. I make coffee now.")
opens_menu = "company_office"

[sub_resource type="Resource" id="Conversation_marge"]
script = ExtResource("2_conv")
needs_flags = PackedStringArray("met_boss")
blocked_by_flags = PackedStringArray("met_marge")
needs_no_job = true
lines = PackedStringArray("Marge. Diner. Pie run. Tidewater. Which word didn't you understand?")
opens_menu = "company_office"

[sub_resource type="Resource" id="Conversation_default"]
script = ExtResource("2_conv")
lines = PackedStringArray("What now, Rabbit? I've got a call at three. With myself. It's important.")
opens_menu = "company_office"

[sub_resource type="Resource" id="Conversation_white_owner"]
script = ExtResource("2_conv")
needs_flags = PackedStringArray("owns_company", "white_voicemail")
blocked_by_flags = PackedStringArray("white_last_load_done")
needs_no_job = true
lines = PackedStringArray("Boss. There's a crate in impound. Your husband's last load. It never made it to Tidewater.", "He was late on it. I docked his pay. Back then. Policy.", "...It's your warehouse now. I put it on the dock for you.")
offers_job = ExtResource("job_white_last_load")
opens_menu = "company_office"

[sub_resource type="Resource" id="Conversation_white_last"]
script = ExtResource("2_conv")
needs_flags = PackedStringArray("white_voicemail")
blocked_by_flags = PackedStringArray("white_last_load_done")
needs_no_job = true
lines = PackedStringArray("Rabbit. Got a crate in impound with your name on it. Your husband's last load.", "Never made it to Tidewater. The client wrote it off. We... kept it.", "Storage fees are astronomical. I'm waiving them. Don't make it a thing.", "He was late on that run. I docked his pay for it. Policy.", "...Get it out of my warehouse.")
offers_job = ExtResource("job_white_last_load")
opens_menu = "company_office"

[resource]
script = ExtResource("1_npc")
display_name = "{boss} ({company})"
species = "lion"
voice_pitch = 0.85
voice_type = "gruff"
voice_key = 1
voice_scale = "minor"
lines = PackedStringArray("What.")
conversations = Array[ExtResource("2_conv")]([SubResource("Conversation_white_owner"), SubResource("Conversation_white_last"), SubResource("Conversation_owner"), SubResource("Conversation_first"), SubResource("Conversation_marge"), SubResource("Conversation_default")])
gives_company_missions = true
comm_name = "{boss} · {company}"
fur_color = Color(0.86, 0.64, 0.32, 1)
accent_color = Color(0.95, 0.95, 0.97, 1)
